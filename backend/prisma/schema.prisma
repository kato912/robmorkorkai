// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // ❌ ห้ามใส่ output ตรงนี้เด็ดขาด
}

datasource db {
  provider = "mysql"
  // url      = env("DATABASE_URL")
}

// --- 1. User (รองรับ Login Google + Auth.js) ---
model User {
  id                String   @id @default(uuid())
  email             String   @unique
  name              String?
  image             String?
  isVerifiedStudent Boolean  @default(false)
  role              Role     @default(USER)
  
  reviews           Review[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastLoginAt       DateTime @default(now())
}

// --- 2. Shop (รองรับ OpenStreetMap) ---
model Shop {
  id            String   @id @default(uuid())
  osmId         String   @unique  // ID จาก OpenStreetMap
  name          String
  type          String?  
  address       String?
  
  // พิกัดสำหรับแสดงบนแผนที่ Leaflet
  latitude      Float
  longitude     Float
  
  coverImage    String?
  openHours     String?
  
  reviews       Review[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- 3. Review ---
model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String   @db.Text
  isFlagged Boolean  @default(false)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}